<UserControl x:Class="JMBackup.Desktop.Lock.LockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#CC000080">
    <Grid>
        <Border Background="White" CornerRadius="12" Width="320" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="JMBackup bloqueado" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                <TextBlock Text="Usuario" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,8" />
                <TextBlock Text="Contraseña" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" KeyDown="PasswordBox_KeyDown" />
                <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                <Button x:Name="UnlockButton" Content="Desbloquear" Click="UnlockButton_Click" Padding="8,4" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
