# =====================================================================
# .NET
# =====================================================================
bin/
obj/
out/

# Resultados de dotnet test / dotnet format
TestResults/
*.trx
*.received.*

# Bases de datos SQLite locales generadas en desarrollo
*.db
*.db-shm
*.db-wal

# Publicación
publish/

# Instalador compilado (Inno Setup)
build/dist/

# Herramientas de usuario de Visual Studio / Rider
*.user
*.suo
.vs/
.idea/
*.userosscache
*.sln.docstates

# Certificados de desarrollo
*.pfx
*.pem

# =====================================================================
# Node / Vite (web/)
# =====================================================================
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# La salida de "vite build" se copia a wwwroot como paso del build de .NET:
# no versionamos ese resultado compilado.
src/JMBackup.Api/wwwroot/**
!src/JMBackup.Api/wwwroot/.gitkeep

# Documento OpenAPI (se genera en cada build de JMBackup.Api, ADR-020) y cliente
# TypeScript generado a partir de él (npm run generate-api): son derivados del
# código de la API, no fuente — regenerarlos es parte del flujo de build normal.
web/openapi/
web/src/lib/api-client.ts

# =====================================================================
# Sistema operativo / editor
# =====================================================================
Thumbs.db
.DS_Store
*.swp
